{
  "name": "roomcraft",
  "private": true,
  "type": "module",
  "description": "3D room planner (plain HTML/CSS/JS + three.js/WebGL) with an MCP server for AI agents",
  "scripts": {
    "start": "node tools/start.mjs",
    "link": "node tools/cli.mjs read",
    "render": "node tools/cli.mjs render",
    "mcp": "node tools/mcp-server.mjs",
    "test": "node --test worker/test/*.test.mjs tools/test/*.test.mjs"
  },
  "dependencies": {
    "camera-controls": "^3.1.2",
    "dxf-parser": "^1.1.2",
    "n8ao": "^2.0.1",
    "playwright": "1.56.1",
    "polygon-clipping": "^0.15.7",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.15",
    "xatlas-web": "^0.1.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
